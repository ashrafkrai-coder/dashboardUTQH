{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Firefox",
      "type": "firefox",
      "request": "launch",
      "url": "http://127.0.0.1:8080",
      "reAttach": true,
      "webRoot": "${workspaceFolder}",
      "pathMappings": [
        {
          "url": "http://127.0.0.1:8080",
          "path": "${workspaceFolder}"
        }
      ],
      "preLaunchTask": "Start local server"
    }
  ]
}
